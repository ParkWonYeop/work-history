[Unit]
Description=Back up the work-history PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=workhistory
Group=workhistory
EnvironmentFile=/etc/work-history/server.env
ExecStart=/opt/work-history/bin/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/work-history
RestrictAddressFamilies=AF_UNIX
UMask=0077
