[Unit]
Description=Reconcile recent Jira and Confluence work history
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=workhistory
Group=workhistory
EnvironmentFile=/etc/work-history/server.env
Environment=ATLASSIAN_API_TOKEN_FILE=%d/atlassian-api-token
Environment=SYNC_LOCK_FILE=/run/work-history/sync.lock
LoadCredential=atlassian-api-token:/etc/work-history/credentials/atlassian-api-token
ExecStart=/opt/work-history/venv/bin/work-history sync --source all --mode reconcile --lookback-days 14
RuntimeDirectory=work-history
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
